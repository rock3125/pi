# piview configuration.  Installed to /etc/piview/piview.env and read both by
# the systemd unit and by `docker compose` run from /opt/piview.
#
# Apply changes with:  piviewctl restart

# ---------------------------------------------------------------- the web view
#
# WHERE THE WEB VIEW LISTENS.  Loopback by default, and that default is the
# safe one: piview has no authentication, and anyone who can open it can run
# any goal, edit the database, and use `load` to read files the interpreter can
# reach.  To serve it to others, put a reverse proxy with authentication and
# TLS in front of 127.0.0.1:7070 rather than opening this up.
PIVIEW_BIND=127.0.0.1
PIVIEW_PORT=7070

# ---------------------------------------------------------------- the interpreter
#
# pi's own TCP port.  piview reaches it over the compose network whatever this
# says; publishing it on the host is only for connecting other clients, and it
# is a plain unauthenticated socket - keep it on loopback.
PI_BIND=127.0.0.1
PI_PORT=7071

# The program loaded when the interpreter starts, as a path inside the
# container.  Files in PIVIEW_PROGRAMS below appear under /app/programs.
PI_PROGRAM=/app/programs/family.pl

# ---------------------------------------------------------------- programs
#
# Host directory holding .pl files.  Mounted read-only into both containers at
# /app/programs, and offered in the web view's sample list, so a file dropped
# here can be loaded from the browser.
PIVIEW_PROGRAMS=/var/lib/piview/programs

# ---------------------------------------------------------------- internals
#
# Set by the installer; changing them takes another install to match.
COMPOSE_PROJECT_NAME=piview
PIVIEW_VERSION=__VERSION__
